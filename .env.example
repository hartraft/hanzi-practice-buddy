# Copy to .env.local for local development. Values below are public client configuration only.
# Never put a Supabase service-role key or database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_POWERSYNC_URL=
# Optional default API root for the shared course-app Neon vocabulary source.
# Users can also configure this in the app; it is a public URL, not a credential.
VITE_COURSE_API_BASE_URL=
